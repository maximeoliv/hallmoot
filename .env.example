# Copié en .env : substitution docker compose (adresse d'écoute côté hôte).
# 127.0.0.1 = accessible seulement depuis la machine. Mettez l'adresse de votre
# réseau privé (VPN, tailnet…) pour y donner accès. Jamais 0.0.0.0.
MOOT_BIND_IP=127.0.0.1
MOOT_PORT=8787

# Run the container as your own user, so the files it writes in ./data belong to
# you. Get the values with `id -u` and `id -g`:
#   printf 'MOOT_UID=%s\nMOOT_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
MOOT_UID=1000
MOOT_GID=1000
